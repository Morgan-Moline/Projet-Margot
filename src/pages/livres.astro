---
import Layout from '../layouts/Layout.astro';

const books = [
  { title: 'Sur les genoux de maman', author: 'Ann Herbert Scott', illustrator: 'Glo Coalson', summary: 'Michaël aime se blottir sur les genoux de sa maman avec ses jouets et ses affaires. Lorsque le bébé veut lui aussi trouver sa place, Michaël découvre qu’il faut apprendre à partager. Un album tendre sur l’arrivée d’un petit frère ou d’une petite sœur.', theme: 'Famille et tendresse', cover: '/images/livres/sur-les-genoux-de-maman.webp', coverAlt: 'Couverture de Sur les genoux de maman' },
  { title: 'Devine combien je t’aime', author: 'Sam McBratney', illustrator: 'Anita Jeram', summary: 'À l’heure du coucher, Petit Lièvre Brun et Grand Lièvre Brun cherchent à se dire combien ils s’aiment. Un album tendre sur l’amour et les liens qui unissent parents et enfants.', theme: 'Famille et tendresse', cover: '/images/livres/Devine-combien-je-t-aime.jpg', coverAlt: 'Couverture de Devine combien je t’aime de Sam McBratney et Anita Jeram' },
  { title: 'Je t’aime', author: 'Guillaume Olive', illustrator: 'Zhi Hong He', summary: 'Un enfant s’endort en se demandant ce que signifie « je t’aime ». Dans ses rêves, il interroge plusieurs animaux, qui lui donnent chacun leur définition de l’amour.', theme: 'Famille et tendresse', cover: '/images/livres/Je-t-aime.jpg', coverAlt: 'Couverture de Je t’aime de Guillaume Olive et Zhi Hong He' },
  { title: 'Ma maman', author: 'Anthony Browne', illustrator: 'Anthony Browne', summary: 'Un petit garçon présente sa formidable maman et ses nombreux talents. Un album tendre et plein d’humour.', theme: 'Famille et tendresse', cover: '/images/livres/MA-MAMAN_ANTHONY-BROWNE-2211081878.jpg', coverAlt: 'Couverture de Ma maman' },
  { title: 'Mon papa', author: 'Anthony Browne', illustrator: 'Anthony Browne', summary: 'Un enfant raconte toutes les qualités de son papa, qu’il imagine fort, drôle et capable de grandes choses. Une déclaration d’amour familiale.', theme: 'Famille et tendresse', cover: '/images/livres/mon-papa-anthony-browne.jpg', coverAlt: 'Couverture de Mon papa' },
  { title: 'Je serai toujours là pour toi', author: 'Mark Sperring', illustrator: 'Layn Marlow', summary: 'Une histoire sur la présence, la protection et l’amour inconditionnel. Elle rassure l’enfant sur le fait qu’il pourra toujours compter sur quelqu’un.', theme: 'Famille et tendresse', cover: '/images/livres/Je-serai-toujours-la-pour-toi.jpg', coverAlt: 'Couverture de Je serai toujours là pour toi' },
  { title: 'Si tu veux voir une baleine', author: 'Julie Fogliano', illustrator: 'Erin E. Stead', summary: 'Un enfant part à la recherche d’une baleine. Pour espérer l’apercevoir, il faut apprendre à attendre, observer et rester attentif au monde qui nous entoure.', theme: 'Découvertes et émotions', cover: '/images/livres/9782877678063-475x500-1.jpg', coverAlt: 'Couverture de Si tu veux voir une baleine' },
  { title: 'Quelque part sous les étoiles', author: 'Ramona Bădescu', illustrator: 'Amélie Jackowski', summary: 'Un petit ver vient au monde et découvre progressivement les formes, les couleurs, les plantes et les animaux qui l’entourent. Un album sensoriel sur les premiers instants de la vie.', theme: 'Découvertes et émotions', cover: '/images/livres/QUELQUE-PART-SOUS-LES-ETOILES_BADESCU-RAMONA-9782492768767.jpg', coverAlt: 'Couverture de Quelque part sous les étoiles' },
  { title: 'Un cœur qui bat', author: 'Virginie Aladjidi', illustrator: 'Joëlle Jolivet', summary: 'Un album illustré qui invite à découvrir le corps, les sensations et le vivant à travers le symbole du cœur qui bat.', theme: 'Découvertes et émotions', cover: '/images/livres/9782364749870.jpg', coverAlt: 'Couverture de Un cœur qui bat' },
  { title: 'Bon voyage, bébé !', author: 'Béatrice Alemagna', illustrator: 'Béatrice Alemagna', summary: 'Les préparatifs du coucher de bébé sont racontés comme ceux d’un grand départ en voyage. Un album plein d’imagination autour du rituel du soir.', theme: 'Découvertes et émotions', cover: '/images/livres/BON-VOYAGE-BEBE_ALEMAGNA-BEATRICE-9782330022501.jpg', coverAlt: 'Couverture de Bon voyage bébé' },
  { title: 'Abris', author: 'Emmanuelle Houdart', illustrator: 'Emmanuelle Houdart', summary: 'Du ventre maternel au berceau, de la maison à l’amour des proches, l’autrice explore les différentes formes de refuge et de protection dans un album aux phrases courtes et musicales.', theme: 'Découvertes et émotions', cover: '/images/livres/ABRIS_HOUDART-EMMANUELLE-9782369020318.jpg', coverAlt: 'Couverture de Abris' },
  { title: 'Bébés chouettes', author: 'Martin Waddell', illustrator: 'Patrick Benson', summary: 'Trois petites chouettes se réveillent et constatent que leur maman est partie. Elles attendent son retour en se rassurant mutuellement. Une histoire sur la séparation et la confiance.', theme: 'Animaux et sommeil', cover: '/images/livres/CC63E991-3634-4451-9E8B-D2B78AA6381D_1024x1024.webp', coverAlt: 'Couverture de Bébés chouettes' },
  { title: 'Mon Tout-Petit', author: 'Jo Weaver', illustrator: 'Jo Weaver', summary: 'Une maman ourse accompagne son petit dans ses premières découvertes au fil des saisons. Une histoire sur la relation parent-enfant et l’autonomie.', theme: 'Animaux et sommeil', cover: '/images/livres/Mon-Tout-Petit.jpg', coverAlt: 'Couverture de Mon Tout-Petit' },
  { title: 'Chut ! Il ne faut pas réveiller les petits lapins qui dorment', author: 'Amélie Jackowski', illustrator: 'Amélie Jackowski', summary: 'Un album sur la nuit et ses sensations apaisantes, à lire doucement avant le coucher pour ne pas réveiller les petits lapins.', theme: 'Animaux et sommeil', cover: '/images/livres/Chut-il-ne-faut-pas-reveiller-les-petits-lapins-qui-dorment.jpg', coverAlt: 'Couverture de Chut ! Il ne faut pas réveiller les petits lapins qui dorment' },
  { title: 'Bonsoir lune', author: 'Margaret Wise Brown', illustrator: 'Clement Hurd', summary: 'Un petit lapin dit bonne nuit aux objets et aux éléments qui l’entourent dans sa chambre. Un grand classique pour accompagner le rituel du coucher.', theme: 'Animaux et sommeil', cover: '/images/livres/image_04d4c6cd-1d77-4fa9-9999-322c28467053_1024x1024.webp', coverAlt: 'Couverture de Bonsoir lune' },
  { title: 'Bon…', author: 'Jeanne Ashbé', illustrator: 'Jeanne Ashbé', summary: 'Un petit canard sort de son œuf, plonge dans l’eau puis s’envole. Deux, trois et bientôt de nombreux autres canetons l’imitent. Un album rythmé pour jouer avec les sons et les mots.', theme: 'Animaux et sommeil', cover: '/images/livres/51b4596f-3545-4c72-9f41-da2a88748e39.webp', coverAlt: 'Couverture de Bon… de Jeanne Ashbé' },
  { title: '2 petites mains et 2 petits pieds', author: 'Mem Fox', illustrator: 'Helen Oxenbury', summary: 'Une comptine présente des bébés nés dans différents endroits du monde. Malgré leurs différences, ils ont tous deux petites mains et deux petits pieds. Une histoire sur la diversité et l’égalité.', theme: 'Comptines et premières découvertes', cover: '/images/livres/91tGoHtX6bL._SL1500_.jpg', coverAlt: 'Couverture de 2 petites mains et 2 petits pieds' },
  { title: 'Pomme pomme pomme', author: 'Corinne Dreyfuss', illustrator: 'Corinne Dreyfuss', summary: 'Une histoire rythmée et ludique autour d’une pomme, avec des répétitions qui invitent les tout-petits à observer, anticiper et participer à la lecture.', theme: 'Comptines et premières découvertes', cover: '/images/livres/pomme-pomme-pomme.svg', coverAlt: 'Couverture illustrée de Pomme pomme pomme' },
  { title: 'Une poule sur un mur', author: 'Thierry Dedieu', illustrator: 'Thierry Dedieu', summary: 'La célèbre comptine « Une poule sur un mur » est mise en images avec humour et en noir et blanc. Un album grand format pensé pour les tout-petits.', theme: 'Comptines et premières découvertes', cover: '/images/livres/Une-poule-sur-un-mur.jpg', coverAlt: 'Couverture de Une poule sur un mur de Thierry Dedieu' },
  { title: 'Comme ça', author: 'Claire Lebourg', illustrator: 'Claire Lebourg', summary: 'Le jour de la naissance d’un enfant, une nouvelle vie commence. Avec tendresse, l’album raconte le quotidien d’une famille, ses joies, ses inquiétudes et ses retrouvailles.', theme: 'Comptines et premières découvertes', cover: '/images/livres/COMME_CA_DP150-1-75rhtia93yx0n4sk28260dvgs86b1gcace8iw1ujvxf.jpg', coverAlt: 'Couverture de Comme ça' },
  { title: 'Un amour profond', author: 'Stephen Hogtun', illustrator: 'Stephen Hogtun', translator: 'Lyse Leroy', summary: 'Une maman baleine met au monde son petit, le guide, le nourrit et lui apprend à vivre. Lorsqu’il devient grand, vient le moment de la séparation, mais le chant d’amour de sa mère continue de l’accompagner.', theme: 'Famille et tendresse', cover: '/images/livres/8c24cafbe386061e575599456b67.png', coverAlt: 'Couverture de Un amour profond' },
];

const themes = ['Tous', ...new Set(books.map((book) => book.theme))];
---

<Layout title="Livres">
  <section class="page-hero">
    <div class="container">
      <p class="eyebrow">Les histoires à partager</p>
      <h1>Les livres</h1>
      <p>Une sélection d’albums pour accompagner les tout-petits et leurs parents : des histoires de tendresse, de découvertes, d’animaux et de premières comptines.</p>
    </div>
  </section>

  <section class="section books-section">
    <div class="container">
      <div class="books-intro">
        <div><p class="eyebrow">La bibliothèque du projet</p><h2>21 histoires à découvrir</h2></div>
        <p>Chaque livre est présenté avec son auteur, son illustrateur lorsqu’il est identifié et un court résumé. Les références qui restent à confirmer sont signalées en toute transparence.</p>
      </div>
      <nav class="book-filters" aria-label="Filtrer les livres par thème">
        {themes.map((theme, index) => <a class:list={['book-filter', { 'is-active': index === 0 }]} href={index === 0 ? '#livres' : '#'} data-theme={theme}>{theme}</a>)}
      </nav>
      <div class="book-grid" id="livres">
        {books.map((book, index) => (
          <article class="book-card" data-book-theme={book.theme}>
            <div class:list={['book-card__cover', { 'book-card__cover--placeholder': !book.cover }]}>
              {book.cover ? <img src={book.cover} alt={book.coverAlt || `Couverture de ${book.title}`} loading="lazy" /> : <div class="book-placeholder"><span aria-hidden="true">📖</span><small>Couverture à confirmer</small></div>}
            </div>
            <div class="book-card__body">
              <span class="book-card__theme">{book.theme}</span>
              <h3>{book.title}</h3>
              <p class="book-card__author"><strong>Auteur :</strong> {book.author}{book.illustrator ? <> · <strong>Illustration :</strong> {book.illustrator}</> : ''}</p>
              {book.translator && <p class="book-card__author"><strong>Traduction :</strong> {book.translator}</p>}
              <p class="book-card__summary">{book.summary}</p>
            </div>
          </article>
        ))}
      </div>
      <p class="books-note">Les couvertures affichées correspondent aux éditions retrouvées en ligne ; elles peuvent différer de celles des exemplaires possédés par le projet. Si une image distante devient indisponible, une couverture de remplacement reprenant le titre et l’auteur s’affiche automatiquement.</p>
    </div>
  </section>

  <section class="section section--soft">
    <div class="container split">
      <div><h2>Des livres pour deux façons de partager.</h2><p>La bibliothèque mobile accompagne les lectures réalisées par les bénévoles dans le service. En parallèle, un petit livre est remis à chaque famille à son arrivée afin qu’elle puisse le garder et poursuivre cette histoire à la maison.</p></div>
      <div class="highlight"><span class="highlight__label">Le saviez-vous ?</span><h3>Le livre remis à la famille lui appartient.</h3><p>Il peut devenir un repère, un souvenir et le début d’un rituel de lecture partagé.</p></div>
    </div>
  </section>
</Layout>

<script>
  const filters = document.querySelectorAll('.book-filter');
  const cards = document.querySelectorAll('.book-card');
  filters.forEach((filter) => {
    filter.addEventListener('click', (event) => {
      event.preventDefault();
      const theme = filter.getAttribute('data-theme');
      filters.forEach((item) => item.classList.toggle('is-active', item === filter));
      cards.forEach((card) => {
        card.hidden = theme !== 'Tous' && card.getAttribute('data-book-theme') !== theme;
      });
    });
  });
  // Une image distante peut disparaître : on affiche alors une couverture de secours
  // construite avec le titre et l'auteur, plutôt qu'un emplacement vide.
  document.querySelectorAll<HTMLImageElement>('.book-card__cover img').forEach((img) => {
    const showFallback = () => {
      const card = img.closest('.book-card');
      const title = card?.querySelector('h3')?.textContent?.trim() || 'Livre';
      const author = card?.querySelector('.book-card__author')?.textContent?.replace('Auteur :', '').trim() || 'Je lis pour toi';
      const fallback = document.createElement('div');
      fallback.className = 'book-cover-fallback';
      fallback.setAttribute('role', 'img');
      fallback.setAttribute('aria-label', `Couverture de remplacement : ${title}, ${author}`);
      const label = document.createElement('span');
      label.textContent = 'JE LIS POUR TOI';
      const heading = document.createElement('strong');
      heading.textContent = title;
      const credit = document.createElement('small');
      credit.textContent = author;
      fallback.append(label, heading, credit);
      img.replaceWith(fallback);
    };
    img.addEventListener('error', showFallback, { once: true });
    if (img.complete && img.naturalWidth === 0) showFallback();
  });
</script>

<style>
  .books-section{padding-top:4rem}
  .books-intro{display:grid;grid-template-columns:1fr 1fr;gap:2rem;align-items:end;margin-bottom:2rem}
  .books-intro h2{margin-bottom:0}
  .books-intro>p{color:var(--muted);max-width:58ch;margin:0}
  .book-filters{display:flex;flex-wrap:wrap;gap:.6rem;margin-bottom:2rem}
  .book-filter{display:inline-flex;padding:.55rem .95rem;border:1px solid var(--line);border-radius:999px;background:var(--paper);color:var(--ink);text-decoration:none;font-size:.88rem;font-weight:600;transition:background .2s,color .2s,border-color .2s}
  .book-filter:hover,.book-filter.is-active{background:var(--blue-deep);border-color:var(--blue-deep);color:white}
  .book-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1.25rem}
  .book-card{overflow:hidden;background:var(--paper);border:1px solid var(--line);border-radius:var(--radius);box-shadow:var(--shadow);display:flex;flex-direction:column}
  .book-card[hidden]{display:none}
  .book-card__cover{height:280px;min-height:280px;flex:0 0 280px;padding:1rem;background:linear-gradient(145deg,#e7eff0,#f7eee7);display:grid;place-items:center}
  .book-card__cover img{display:block;height:100%;width:100%;max-width:100%;min-width:0;object-fit:contain;filter:drop-shadow(0 8px 10px rgb(30 50 60 / 14%))}
  .book-cover-fallback{height:100%;width:min(100%,210px);aspect-ratio:3/4;display:flex;flex-direction:column;align-items:center;justify-content:space-between;text-align:center;padding:1.4rem 1rem;background:linear-gradient(145deg,#dceaf3,#f8f6f1 58%,#f3e9ce);border:8px solid #fffefa;outline:1px solid #d8d3c8;box-shadow:0 8px 18px rgb(30 50 60 / 18%);color:var(--ink)}
  .book-cover-fallback span{font-size:.58rem;letter-spacing:.18em;font-weight:700;color:var(--blue-deep)}
  .book-cover-fallback strong{font-family:var(--font-display);font-size:1.25rem;line-height:1.2}
  .book-cover-fallback small{font-size:.68rem;color:var(--muted)}
  .book-card__cover--placeholder{background:linear-gradient(145deg,#e4eee8,#f4e8df)}
  .book-placeholder{height:100%;width:100%;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:.5rem;color:var(--blue-deep)}
  .book-placeholder span{font-size:3.5rem}
  .book-placeholder small{font-size:.75rem;font-weight:700;letter-spacing:.04em;text-transform:uppercase}
  .book-card__body{min-width:0;overflow-wrap:anywhere;padding:1.25rem;display:flex;flex-direction:column;flex:1}
  .book-card__theme{font-size:.68rem;text-transform:uppercase;letter-spacing:.1em;color:var(--blue-deep);font-weight:700;margin-bottom:.55rem}
  .book-card h3{font-size:1.35rem;margin-bottom:.6rem}
  .book-card__author{font-size:.82rem;color:var(--muted);margin:0 0 .5rem;line-height:1.5}
  .book-card__summary{min-width:0;overflow-wrap:anywhere;word-break:normal;font-size:.92rem;color:#465e69;margin:.65rem 0 0}
  .books-note{margin:2rem 0 0;padding:1rem 1.2rem;border-left:3px solid #b8cbd2;background:var(--paper);color:var(--muted);font-size:.85rem}
  @media(max-width:850px){.book-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.books-intro{grid-template-columns:1fr;gap:1rem}}
  @media(max-width:560px){.book-grid{grid-template-columns:1fr}.book-card__cover{height:300px;min-height:300px;flex-basis:300px}.book-filters{gap:.45rem}.book-filter{font-size:.8rem}}
</style>
