---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import { books, giftBook, themes } from '../data/livres';
---

<Layout title="Livres" description="La sélection d’albums de la bibliothèque mobile « Je lis pour toi », avec auteurs, illustrateurs et résumés.">
  <section class="page-hero">
    <div class="container">
      <p class="eyebrow">Les histoires à partager</p>
      <h1>Les livres</h1>
      <p>Une sélection d’albums pour accompagner les tout-petits et leurs parents : des histoires de tendresse, de découvertes, d’animaux et de premières comptines.</p>
    </div>
  </section>

  <section class="section books-section">
    <div class="container">
      <div class="books-intro">
        <div><p class="eyebrow">La bibliothèque du projet</p><h2>{books.length} histoires à découvrir</h2></div>
        <p>Chaque livre est présenté avec son auteur, son illustrateur lorsqu’il est identifié et un court résumé.</p>
      </div>
      <div class="book-filters" role="group" aria-label="Filtrer les livres par thème" hidden>
        {themes.map((theme, index) => <button type="button" class="book-filter" data-theme={theme} aria-pressed={index === 0 ? 'true' : 'false'} aria-controls="livres">{theme}</button>)}
      </div>
      <p class="visually-hidden" id="livres-statut" aria-live="polite"></p>
      <div class="book-grid" id="livres">
        {books.map((book) => (
          <article class="book-card" data-book-theme={book.theme}>
            <div class="book-card__cover">
              <Image src={book.cover} alt={book.coverAlt ?? `Couverture de ${book.title}`} height={280} densities={[1, 2]} loading="lazy" decoding="async" />
            </div>
            <div class="book-card__body">
              <span class="book-card__theme">{book.theme}</span>
              <h3>{book.title}</h3>
              <p class="book-card__author"><strong>Auteur :</strong> {book.author}{book.illustrator && <> · <strong>Illustration :</strong> {book.illustrator}</>}</p>
              {book.translator && <p class="book-card__author"><strong>Traduction :</strong> {book.translator}</p>}
              <p class="book-card__summary">{book.summary}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--soft">
    <div class="container split">
      <div><h2>Des livres pour deux façons de partager.</h2><p>La bibliothèque mobile permet aux bénévoles de faire découvrir différents albums aux familles lors des temps de lecture dans le service. À chaque entrée dans le service, un seul livre est offert à la famille : <strong>{giftBook.title}</strong>, de {giftBook.author}. Ce livre lui appartient et peut être emporté à la maison.</p></div>
      <div class="highlight"><span class="highlight__label">Le saviez-vous ?</span><div class="highlight__book"><Image src={giftBook.cover} alt={`Couverture du livre ${giftBook.title} de ${giftBook.author}`} width={190} densities={[1, 2]} loading="lazy" decoding="async" /><div><h3>Un livre offert à chaque famille : {giftBook.title}, de {giftBook.author}.</h3><p>Ce livre est remis à chaque entrée dans le service. C’est le seul album offert ; les autres livres sont disponibles dans la bibliothèque mobile pour être lus sur place avec les bénévoles.</p></div></div></div>
    </div>
  </section>
</Layout>

<script>
  const group = document.querySelector<HTMLElement>('.book-filters');
  const filters = document.querySelectorAll<HTMLButtonElement>('.book-filter');
  const cards = document.querySelectorAll<HTMLElement>('.book-card');
  const status = document.getElementById('livres-statut');
  // Les filtres ne servent qu’avec JavaScript : on ne les affiche qu’à ce moment-là.
  if (group) group.hidden = false;
  filters.forEach((filter) => {
    filter.addEventListener('click', () => {
      const theme = filter.dataset.theme;
      filters.forEach((item) => item.setAttribute('aria-pressed', String(item === filter)));
      let visible = 0;
      cards.forEach((card) => {
        card.hidden = theme !== 'Tous' && card.dataset.bookTheme !== theme;
        if (!card.hidden) visible += 1;
      });
      if (status) status.textContent = `${visible} livre${visible > 1 ? 's' : ''} affiché${visible > 1 ? 's' : ''}`;
    });
  });
</script>

<style>
  .highlight__book{display:grid;grid-template-columns:minmax(90px,32%) minmax(0,1fr);gap:1rem;align-items:center;margin-top:.75rem}.highlight__book img{display:block;width:100%;max-height:190px;object-fit:contain;border-radius:.35rem}.highlight__book h3{margin:0 0 .5rem}.highlight__book p{margin:0}
  .books-section{padding-top:4rem}
  .books-intro{display:grid;grid-template-columns:1fr 1fr;gap:2rem;align-items:end;margin-bottom:2rem}
  .books-intro h2{margin-bottom:0}
  .books-intro>p{color:var(--muted);max-width:58ch;margin:0}
  .book-filters{display:flex;flex-wrap:wrap;gap:.6rem;margin-bottom:2rem}
  .book-filters[hidden]{display:none}
  .book-filter{display:inline-flex;font:inherit;cursor:pointer;padding:.55rem .95rem;border:1px solid var(--line);border-radius:999px;background:var(--paper);color:var(--ink);text-decoration:none;font-size:.88rem;font-weight:600;transition:background .2s,color .2s,border-color .2s}
  .book-filter:focus-visible{outline:3px solid #d49b55;outline-offset:2px}
  .book-filter:hover,.book-filter[aria-pressed=true]{background:var(--blue-deep);border-color:var(--blue-deep);color:white}
  .book-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1.25rem}
  .book-card{min-width:0;overflow:hidden;background:var(--paper);border:1px solid var(--line);border-radius:var(--radius);box-shadow:var(--shadow);display:grid;grid-template-columns:minmax(130px,38%) minmax(0,1fr);align-items:stretch}
  .book-card[hidden]{display:none}
  .book-card__cover{height:auto;min-height:260px;min-width:0;padding:1rem;background:linear-gradient(145deg,#e7eff0,#f7eee7);display:flex;align-items:center;justify-content:center;overflow:hidden}
  .book-card__cover img{display:block;width:auto;height:auto;max-width:100%;max-height:280px;object-fit:contain;flex:0 1 auto;filter:drop-shadow(0 8px 10px rgb(30 50 60 / 14%))}
  .book-card__body{min-width:0;overflow-wrap:anywhere;padding:1.25rem;display:flex;flex-direction:column;justify-content:center}
  .book-card__theme{font-size:.68rem;text-transform:uppercase;letter-spacing:.1em;color:var(--blue-deep);font-weight:700;margin-bottom:.55rem}
  .book-card h3{font-size:1.25rem;margin-bottom:.6rem;overflow-wrap:anywhere}
  .book-card__author{font-size:.8rem;color:var(--muted);margin:0 0 .5rem;line-height:1.5;overflow-wrap:anywhere}
  .book-card__summary{min-width:0;overflow-wrap:anywhere;word-break:normal;font-size:.88rem;line-height:1.55;color:#465e69;margin:.55rem 0 0}
  @media(max-width:850px){.book-grid{grid-template-columns:1fr}.books-intro{grid-template-columns:1fr;gap:1rem}}
  @media(max-width:560px){.book-card{grid-template-columns:minmax(105px,34%) minmax(0,1fr)}.book-card__cover{min-height:230px;padding:.65rem}.book-card__cover img{max-height:250px}.book-card__body{padding:1rem}.book-card h3{font-size:1.12rem}.book-card__summary{font-size:.84rem}.book-filters{gap:.45rem}.book-filter{font-size:.8rem}}
</style>
