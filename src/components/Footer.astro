---
import { links, base } from '../data/nav';
const year = new Date().getFullYear();
---
<footer class="footer">
  <div class="container footer__main">
    <div class="footer__identity">
      <span class="footer__brand">Je lis pour toi</span>
      <p>La lecture crée du lien, dès les premiers jours de vie.</p>
    </div>
    <nav aria-label="Navigation de pied de page"><ul>{links.map((link) => <li><a href={link.href}>{link.label}</a></li>)}</ul></nav>
  </div>
  <div class="container footer__bottom"><span>© {year} – Je lis pour toi</span><a href={`${base}/contact`}>Une question sur le projet ?</a></div>
</footer>
