---
interface Props {
  title: string;
  icon?: string;
}

const { title, icon } = Astro.props;
---

<article class="card">
  {icon && <div class="card__icon" aria-hidden="true">{icon}</div>}
  <h3>{title}</h3>
  <slot />
</article>

<style>
  .card {
    background: #fff;
    border: 1px solid var(--color-border);
    border-top: 5px solid var(--green);
    border-radius: var(--radius);
    padding: 1.75rem;
    box-shadow: var(--shadow);
  }

  .card:nth-child(3n + 2) {
    border-top-color: var(--orange);
  }

  .card:nth-child(3n) {
    border-top-color: var(--brown);
  }

  .card__icon {
    width: 48px;
    height: 48px;
    display: grid;
    place-items: center;
    font-size: 1.5rem;
    border-radius: 12px;
    color: var(--brown);
    background: color-mix(in srgb, var(--green) 28%, var(--cream));
    margin-bottom: 1rem;
  }

  .card :global(p:last-child) {
    margin-bottom: 0;
    color: var(--color-muted);
  }
</style>
